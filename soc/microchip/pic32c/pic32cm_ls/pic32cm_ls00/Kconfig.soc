config SOC_SERIES_PIC32CM_LS00
	bool
	select SOC_FAMILY_MICROCHIP_PIC32CM_LS

	help
	  Enable support for Microchip PIC32CM LS00 Cortex-M23 microcontrollers.

config SOC_SERIES
	default "pic32cm_ls00" if SOC_SERIES_PIC32CM_LS00

config SOC_PIC32CM5164LS00048
	bool
	select SOC_SERIES_PIC32CM_LS00

config SOC
	default "pic32cm5164ls00048" if SOC_PIC32CM5164LS00048
