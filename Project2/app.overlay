#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    led1: user_led1 {
        compatible = "gpio-leds";
        gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
        label = "LED1";
    };

    led2: user_led2 {
        compatible = "gpio-leds";
        gpios = <&gpiob 3 GPIO_ACTIVE_HIGH>;
        label = "LED2";
    };
};
        
